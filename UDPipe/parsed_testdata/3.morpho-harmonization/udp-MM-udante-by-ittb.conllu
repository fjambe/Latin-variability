# sent_id = DVE-179
# text = Potest tamen magis in una quam in alia redolere, sicut simplicissima substantiarum, que Deus est, in homine magis redolet quam in bruto, in animali quam in planta, in hac quam in minera, in hac quam in elemento, in igne quam in terra; et simplicissima quantitas, quod est unum, in impari numero redolet magis quam in pari; et simplicissimus color, qui albus est, magis in citrino quam in viride redolet.
# citation_hierarchy = Liber_Primus,xvi,Paragraphus_5
